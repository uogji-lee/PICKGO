PICKGO_JWT_SECRET=replace-with-a-long-random-string
TOUR_API_SERVICE_KEY=your-data-go-kr-decoding-key
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key
KAKAO_CLIENT_SECRET=your-kakao-login-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
PICKGO_PUBLIC_URL=http://localhost:3000
# Set to 1 only behind a trusted reverse proxy. Production requires HTTPS.
PICKGO_TRUST_PROXY=0
# 문의하기 운영자: 답변·종료 권한을 줄 PICKGO 계정 id (쉼표로 여러 명, 예: 1,7).
# 운영자 본인 계정으로 로그인한 뒤 /api/me 를 열어 나오는 "id" 값을 넣고 서버를 재시작하세요.
PICKGO_ADMIN_USER_IDS=
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# Preparation only: Google results are not yet wired into recommendations.
GOOGLE_PLACES_API_KEY=
